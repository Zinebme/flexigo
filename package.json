{
  "name": "flexigo",
  "version": "0.1.0",
  "private": true,
  "description": "FlexiGo — plateforme multi-tenant de création et de gestion de sites web (e-commerce COD, landing, portfolio) pour le marché algérien et au-delà.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:integration": "node tests/integration/run.mjs",
    "test:db": "node tests/integration/run.mjs",
    "db:local:setup": "bash scripts/local-db.sh setup",
    "db:local:migrate": "bash scripts/local-db.sh migrate",
    "db:local:seed": "bash scripts/local-db.sh seed",
    "preview:souq": "FLEXIGO_PREVIEW=1 next dev -H 0.0.0.0",
    "preview:lamsa": "FLEXIGO_PREVIEW=1 next dev -H 0.0.0.0",
    "preview:noor": "FLEXIGO_PREVIEW=1 next dev -H 0.0.0.0",
    "preview:volt": "FLEXIGO_PREVIEW=1 next dev -H 0.0.0.0",
    "preview:dar": "FLEXIGO_PREVIEW=1 next dev -H 0.0.0.0",
    "preview:pulse": "FLEXIGO_PREVIEW=1 next dev -H 0.0.0.0",
    "preview:little": "FLEXIGO_PREVIEW=1 next dev -H 0.0.0.0"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.30.0",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
