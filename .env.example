# ==============================================================================
# FlexiGo — Environment variables
# Copy to .env.local for local development. NEVER commit real values.
# ==============================================================================

# --- Supabase (required) ------------------------------------------------------
# Project URL, e.g. https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key (safe for the browser — RLS protects the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY. Bypasses RLS. Must NEVER be exposed to the browser and NEVER
# prefixed with NEXT_PUBLIC_. Loaded only in server-side code (route handlers,
# server components, proxy).
SUPABASE_SERVICE_ROLE_KEY=

# --- Secrets encryption (required in production) ------------------------------
# 32-byte base64 key (e.g. `openssl rand -base64 32`). Used to encrypt
# integration credentials (shipping tokens, Google service accounts) at rest.
CREDENTIALS_ENCRYPTION_KEY=

# --- Application (optional) ----------------------------------------------------
# Public base URL of the platform (used for canonical URLs, sitemaps, emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Platform support contact shown to merchants
FLEXIGO_SUPPORT_EMAIL=support@example.com
# Comma-separated list of trusted hosts that should serve the platform landing
# page instead of a tenant storefront (your own domain, preview subdomain, etc.)
FLEXIGO_PLATFORM_HOSTS=localhost,127.0.0.1,localhost:3000

# --- Local Postgres (optional, for SQL integration tests only) -----------------
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/flexigo_test
